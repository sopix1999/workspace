# Supabase pooled connection URL (port 6543)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# JWT secret for auth
JWT_SECRET=change_this_in_production

# Gemini API key (optional)
GEMINI_KEY=your_gemini_api_key

# Payment webhook secret (optional)
PAYMENT_WEBHOOK_SECRET=change_this_too

# Admin WhatsApp number (optional)
ADMIN_WA=62xxxxxxxxxx

# Debug mode (optional)
DEBUG=1