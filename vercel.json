{
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/cron/(.*)",
      "dest": "/api/cron/$1"
    },
    {
      "src": "/__gas",
      "dest": "/api/[[...path]]"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[[...path]]"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}